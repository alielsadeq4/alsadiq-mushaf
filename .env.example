# ============================================================================
# منصة الصادق — متغيرات البيئة
# Environment Variables
# ============================================================================
#
# انسخ هذا الملف إلى .env.local وعدّل القيم حسب الحاجة
# Copy this file to .env.local and fill in the values as needed
#
# ملاحظة: المنصة تعمل بدون أي مفاتيح API.
# جميع المصادر الصوتية والدينية عامة ومجانية ولا تتطلب مصادقة.
# Note: The platform works without any API keys.
# All audio and religious sources are public, free, and require no auth.

# ============================================================================
# اختياري — Optional
# ============================================================================

# Base URL of the deployed site (for SEO and metadata)
# Used for generating absolute URLs in sitemap, OpenGraph, etc.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ============================================================================
# للحصول على أفضل أداء (اختياري)
# For best performance (optional)
# ============================================================================

# Upstash Redis URL (for server-side caching, optional)
# REDIS_URL=
# REDIS_TOKEN=

# Analytics (optional — disabled by default for privacy)
# NEXT_PUBLIC_ANALYTICS_ID=

# ============================================================================
# ملاحظات أمنية مهمة
# Important Security Notes
# ============================================================================
#
# 1. لا تضع أي أسرار في الكود (Secrets in code)
# 2. استخدم NEXT_PUBLIC_ فقط للمتغيرات التي يجب أن تظهر للمتصفح
# 3. المتغيرات الحساسة يجب أن تكون على الخادم فقط (server-only)
# 4. على Vercel، أضف المتغيرات من لوحة التحكم > Settings > Environment Variables
#
# 1. Never hardcode secrets in code
# 2. Use NEXT_PUBLIC_ prefix only for browser-exposed variables
# 3. Sensitive variables must be server-only
# 4. On Vercel, add variables via Settings > Environment Variables
