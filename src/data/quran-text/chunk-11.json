{"111":[{"n":6217,"key":"111:1","text":" تَبَّتْ يَدَآ أَبِى لَهَبٍ وَتَبَّ"},{"n":6218,"key":"111:2","text":"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ"},{"n":6219,"key":"111:3","text":"سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ"},{"n":6220,"key":"111:4","text":"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ"},{"n":6221,"key":"111:5","text":"فِى جِيدِهَا حَبْلٌ مِّن مَّسَدٍۭ"}],"112":[{"n":6222,"key":"112:1","text":" قُلْ هُوَ ٱللَّهُ أَحَدٌ"},{"n":6223,"key":"112:2","text":"ٱللَّهُ ٱلصَّمَدُ"},{"n":6224,"key":"112:3","text":"لَمْ يَلِدْ وَلَمْ يُولَدْ"},{"n":6225,"key":"112:4","text":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ"}],"113":[{"n":6226,"key":"113:1","text":" قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ"},{"n":6227,"key":"113:2","text":"مِن شَرِّ مَا خَلَقَ"},{"n":6228,"key":"113:3","text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ"},{"n":6229,"key":"113:4","text":"وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ"},{"n":6230,"key":"113:5","text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ"}],"114":[{"n":6231,"key":"114:1","text":" قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ"},{"n":6232,"key":"114:2","text":"مَلِكِ ٱلنَّاسِ"},{"n":6233,"key":"114:3","text":"إِلَـٰهِ ٱلنَّاسِ"},{"n":6234,"key":"114:4","text":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ"},{"n":6235,"key":"114:5","text":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ"},{"n":6236,"key":"114:6","text":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ"}]}