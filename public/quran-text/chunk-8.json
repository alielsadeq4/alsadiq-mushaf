{"81":[{"n":5801,"key":"81:1","text":" إِذَا ٱلشَّمْسُ كُوِّرَتْ"},{"n":5802,"key":"81:2","text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ"},{"n":5803,"key":"81:3","text":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ"},{"n":5804,"key":"81:4","text":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ"},{"n":5805,"key":"81:5","text":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ"},{"n":5806,"key":"81:6","text":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ"},{"n":5807,"key":"81:7","text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ"},{"n":5808,"key":"81:8","text":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ"},{"n":5809,"key":"81:9","text":"بِأَىِّ ذَنۢبٍ قُتِلَتْ"},{"n":5810,"key":"81:10","text":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ"},{"n":5811,"key":"81:11","text":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ"},{"n":5812,"key":"81:12","text":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ"},{"n":5813,"key":"81:13","text":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ"},{"n":5814,"key":"81:14","text":"عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ"},{"n":5815,"key":"81:15","text":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ"},{"n":5816,"key":"81:16","text":"ٱلْجَوَارِ ٱلْكُنَّسِ"},{"n":5817,"key":"81:17","text":"وَٱلَّيْلِ إِذَا عَسْعَسَ"},{"n":5818,"key":"81:18","text":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ"},{"n":5819,"key":"81:19","text":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ"},{"n":5820,"key":"81:20","text":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ"},{"n":5821,"key":"81:21","text":"مُّطَاعٍ ثَمَّ أَمِينٍ"},{"n":5822,"key":"81:22","text":"وَمَا صَاحِبُكُم بِمَجْنُونٍ"},{"n":5823,"key":"81:23","text":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ"},{"n":5824,"key":"81:24","text":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ"},{"n":5825,"key":"81:25","text":"وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ"},{"n":5826,"key":"81:26","text":"فَأَيْنَ تَذْهَبُونَ"},{"n":5827,"key":"81:27","text":"إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ"},{"n":5828,"key":"81:28","text":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ"},{"n":5829,"key":"81:29","text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ"}],"82":[{"n":5830,"key":"82:1","text":" إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ"},{"n":5831,"key":"82:2","text":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ"},{"n":5832,"key":"82:3","text":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ"},{"n":5833,"key":"82:4","text":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ"},{"n":5834,"key":"82:5","text":"عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ"},{"n":5835,"key":"82:6","text":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ"},{"n":5836,"key":"82:7","text":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ"},{"n":5837,"key":"82:8","text":"فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ"},{"n":5838,"key":"82:9","text":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ"},{"n":5839,"key":"82:10","text":"وَإِنَّ عَلَيْكُمْ لَحَـٰفِظِينَ"},{"n":5840,"key":"82:11","text":"كِرَامًا كَـٰتِبِينَ"},{"n":5841,"key":"82:12","text":"يَعْلَمُونَ مَا تَفْعَلُونَ"},{"n":5842,"key":"82:13","text":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ"},{"n":5843,"key":"82:14","text":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ"},{"n":5844,"key":"82:15","text":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ"},{"n":5845,"key":"82:16","text":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ"},{"n":5846,"key":"82:17","text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ"},{"n":5847,"key":"82:18","text":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ"},{"n":5848,"key":"82:19","text":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ"}],"83":[{"n":5849,"key":"83:1","text":" وَيْلٌ لِّلْمُطَفِّفِينَ"},{"n":5850,"key":"83:2","text":"ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ"},{"n":5851,"key":"83:3","text":"وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ"},{"n":5852,"key":"83:4","text":"أَلَا يَظُنُّ أُو۟لَـٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ"},{"n":5853,"key":"83:5","text":"لِيَوْمٍ عَظِيمٍ"},{"n":5854,"key":"83:6","text":"يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَـٰلَمِينَ"},{"n":5855,"key":"83:7","text":"كَلَّآ إِنَّ كِتَـٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍ"},{"n":5856,"key":"83:8","text":"وَمَآ أَدْرَىٰكَ مَا سِجِّينٌ"},{"n":5857,"key":"83:9","text":"كِتَـٰبٌ مَّرْقُومٌ"},{"n":5858,"key":"83:10","text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"n":5859,"key":"83:11","text":"ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ"},{"n":5860,"key":"83:12","text":"وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ"},{"n":5861,"key":"83:13","text":"إِذَا تُتْلَىٰ عَلَيْهِ ءَايَـٰتُنَا قَالَ أَسَـٰطِيرُ ٱلْأَوَّلِينَ"},{"n":5862,"key":"83:14","text":"كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ"},{"n":5863,"key":"83:15","text":"كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍ لَّمَحْجُوبُونَ"},{"n":5864,"key":"83:16","text":"ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ"},{"n":5865,"key":"83:17","text":"ثُمَّ يُقَالُ هَـٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ"},{"n":5866,"key":"83:18","text":"كَلَّآ إِنَّ كِتَـٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ"},{"n":5867,"key":"83:19","text":"وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ"},{"n":5868,"key":"83:20","text":"كِتَـٰبٌ مَّرْقُومٌ"},{"n":5869,"key":"83:21","text":"يَشْهَدُهُ ٱلْمُقَرَّبُونَ"},{"n":5870,"key":"83:22","text":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ"},{"n":5871,"key":"83:23","text":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ"},{"n":5872,"key":"83:24","text":"تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ"},{"n":5873,"key":"83:25","text":"يُسْقَوْنَ مِن رَّحِيقٍ مَّخْتُومٍ"},{"n":5874,"key":"83:26","text":"خِتَـٰمُهُۥ مِسْكٌ ۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَـٰفِسُونَ"},{"n":5875,"key":"83:27","text":"وَمِزَاجُهُۥ مِن تَسْنِيمٍ"},{"n":5876,"key":"83:28","text":"عَيْنًا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ"},{"n":5877,"key":"83:29","text":"إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ"},{"n":5878,"key":"83:30","text":"وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ"},{"n":5879,"key":"83:31","text":"وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ"},{"n":5880,"key":"83:32","text":"وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَـٰٓؤُلَآءِ لَضَآلُّونَ"},{"n":5881,"key":"83:33","text":"وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَـٰفِظِينَ"},{"n":5882,"key":"83:34","text":"فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ"},{"n":5883,"key":"83:35","text":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ"},{"n":5884,"key":"83:36","text":"هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ"}],"84":[{"n":5885,"key":"84:1","text":" إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ"},{"n":5886,"key":"84:2","text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"n":5887,"key":"84:3","text":"وَإِذَا ٱلْأَرْضُ مُدَّتْ"},{"n":5888,"key":"84:4","text":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ"},{"n":5889,"key":"84:5","text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"n":5890,"key":"84:6","text":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَـٰقِيهِ"},{"n":5891,"key":"84:7","text":"فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ"},{"n":5892,"key":"84:8","text":"فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا"},{"n":5893,"key":"84:9","text":"وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا"},{"n":5894,"key":"84:10","text":"وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ وَرَآءَ ظَهْرِهِۦ"},{"n":5895,"key":"84:11","text":"فَسَوْفَ يَدْعُوا۟ ثُبُورًا"},{"n":5896,"key":"84:12","text":"وَيَصْلَىٰ سَعِيرًا"},{"n":5897,"key":"84:13","text":"إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا"},{"n":5898,"key":"84:14","text":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ"},{"n":5899,"key":"84:15","text":"بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا"},{"n":5900,"key":"84:16","text":"فَلَآ أُقْسِمُ بِٱلشَّفَقِ"},{"n":5901,"key":"84:17","text":"وَٱلَّيْلِ وَمَا وَسَقَ"},{"n":5902,"key":"84:18","text":"وَٱلْقَمَرِ إِذَا ٱتَّسَقَ"},{"n":5903,"key":"84:19","text":"لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ"},{"n":5904,"key":"84:20","text":"فَمَا لَهُمْ لَا يُؤْمِنُونَ"},{"n":5905,"key":"84:21","text":"وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩"},{"n":5906,"key":"84:22","text":"بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ"},{"n":5907,"key":"84:23","text":"وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ"},{"n":5908,"key":"84:24","text":"فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ"},{"n":5909,"key":"84:25","text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ"}],"85":[{"n":5910,"key":"85:1","text":" وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ"},{"n":5911,"key":"85:2","text":"وَٱلْيَوْمِ ٱلْمَوْعُودِ"},{"n":5912,"key":"85:3","text":"وَشَاهِدٍ وَمَشْهُودٍ"},{"n":5913,"key":"85:4","text":"قُتِلَ أَصْحَـٰبُ ٱلْأُخْدُودِ"},{"n":5914,"key":"85:5","text":"ٱلنَّارِ ذَاتِ ٱلْوَقُودِ"},{"n":5915,"key":"85:6","text":"إِذْ هُمْ عَلَيْهَا قُعُودٌ"},{"n":5916,"key":"85:7","text":"وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌ"},{"n":5917,"key":"85:8","text":"وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ"},{"n":5918,"key":"85:9","text":"ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ شَهِيدٌ"},{"n":5919,"key":"85:10","text":"إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ"},{"n":5920,"key":"85:11","text":"إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ جَنَّـٰتٌ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ"},{"n":5921,"key":"85:12","text":"إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ"},{"n":5922,"key":"85:13","text":"إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ"},{"n":5923,"key":"85:14","text":"وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ"},{"n":5924,"key":"85:15","text":"ذُو ٱلْعَرْشِ ٱلْمَجِيدُ"},{"n":5925,"key":"85:16","text":"فَعَّالٌ لِّمَا يُرِيدُ"},{"n":5926,"key":"85:17","text":"هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ"},{"n":5927,"key":"85:18","text":"فِرْعَوْنَ وَثَمُودَ"},{"n":5928,"key":"85:19","text":"بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍ"},{"n":5929,"key":"85:20","text":"وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ"},{"n":5930,"key":"85:21","text":"بَلْ هُوَ قُرْءَانٌ مَّجِيدٌ"},{"n":5931,"key":"85:22","text":"فِى لَوْحٍ مَّحْفُوظٍۭ"}],"86":[{"n":5932,"key":"86:1","text":" وَٱلسَّمَآءِ وَٱلطَّارِقِ"},{"n":5933,"key":"86:2","text":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ"},{"n":5934,"key":"86:3","text":"ٱلنَّجْمُ ٱلثَّاقِبُ"},{"n":5935,"key":"86:4","text":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ"},{"n":5936,"key":"86:5","text":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ"},{"n":5937,"key":"86:6","text":"خُلِقَ مِن مَّآءٍ دَافِقٍ"},{"n":5938,"key":"86:7","text":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ"},{"n":5939,"key":"86:8","text":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ"},{"n":5940,"key":"86:9","text":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ"},{"n":5941,"key":"86:10","text":"فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ"},{"n":5942,"key":"86:11","text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ"},{"n":5943,"key":"86:12","text":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ"},{"n":5944,"key":"86:13","text":"إِنَّهُۥ لَقَوْلٌ فَصْلٌ"},{"n":5945,"key":"86:14","text":"وَمَا هُوَ بِٱلْهَزْلِ"},{"n":5946,"key":"86:15","text":"إِنَّهُمْ يَكِيدُونَ كَيْدًا"},{"n":5947,"key":"86:16","text":"وَأَكِيدُ كَيْدًا"},{"n":5948,"key":"86:17","text":"فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا"}],"87":[{"n":5949,"key":"87:1","text":" سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى"},{"n":5950,"key":"87:2","text":"ٱلَّذِى خَلَقَ فَسَوَّىٰ"},{"n":5951,"key":"87:3","text":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ"},{"n":5952,"key":"87:4","text":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ"},{"n":5953,"key":"87:5","text":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ"},{"n":5954,"key":"87:6","text":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ"},{"n":5955,"key":"87:7","text":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ"},{"n":5956,"key":"87:8","text":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ"},{"n":5957,"key":"87:9","text":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ"},{"n":5958,"key":"87:10","text":"سَيَذَّكَّرُ مَن يَخْشَىٰ"},{"n":5959,"key":"87:11","text":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى"},{"n":5960,"key":"87:12","text":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ"},{"n":5961,"key":"87:13","text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ"},{"n":5962,"key":"87:14","text":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ"},{"n":5963,"key":"87:15","text":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ"},{"n":5964,"key":"87:16","text":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا"},{"n":5965,"key":"87:17","text":"وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ"},{"n":5966,"key":"87:18","text":"إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ"},{"n":5967,"key":"87:19","text":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ"}],"88":[{"n":5968,"key":"88:1","text":" هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ"},{"n":5969,"key":"88:2","text":"وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ"},{"n":5970,"key":"88:3","text":"عَامِلَةٌ نَّاصِبَةٌ"},{"n":5971,"key":"88:4","text":"تَصْلَىٰ نَارًا حَامِيَةً"},{"n":5972,"key":"88:5","text":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ"},{"n":5973,"key":"88:6","text":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ"},{"n":5974,"key":"88:7","text":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ"},{"n":5975,"key":"88:8","text":"وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ"},{"n":5976,"key":"88:9","text":"لِّسَعْيِهَا رَاضِيَةٌ"},{"n":5977,"key":"88:10","text":"فِى جَنَّةٍ عَالِيَةٍ"},{"n":5978,"key":"88:11","text":"لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً"},{"n":5979,"key":"88:12","text":"فِيهَا عَيْنٌ جَارِيَةٌ"},{"n":5980,"key":"88:13","text":"فِيهَا سُرُرٌ مَّرْفُوعَةٌ"},{"n":5981,"key":"88:14","text":"وَأَكْوَابٌ مَّوْضُوعَةٌ"},{"n":5982,"key":"88:15","text":"وَنَمَارِقُ مَصْفُوفَةٌ"},{"n":5983,"key":"88:16","text":"وَزَرَابِىُّ مَبْثُوثَةٌ"},{"n":5984,"key":"88:17","text":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ"},{"n":5985,"key":"88:18","text":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ"},{"n":5986,"key":"88:19","text":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ"},{"n":5987,"key":"88:20","text":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ"},{"n":5988,"key":"88:21","text":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ"},{"n":5989,"key":"88:22","text":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ"},{"n":5990,"key":"88:23","text":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ"},{"n":5991,"key":"88:24","text":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ"},{"n":5992,"key":"88:25","text":"إِنَّ إِلَيْنَآ إِيَابَهُمْ"},{"n":5993,"key":"88:26","text":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم"}],"89":[{"n":5994,"key":"89:1","text":" وَٱلْفَجْرِ"},{"n":5995,"key":"89:2","text":"وَلَيَالٍ عَشْرٍ"},{"n":5996,"key":"89:3","text":"وَٱلشَّفْعِ وَٱلْوَتْرِ"},{"n":5997,"key":"89:4","text":"وَٱلَّيْلِ إِذَا يَسْرِ"},{"n":5998,"key":"89:5","text":"هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ"},{"n":5999,"key":"89:6","text":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ"},{"n":6000,"key":"89:7","text":"إِرَمَ ذَاتِ ٱلْعِمَادِ"},{"n":6001,"key":"89:8","text":"ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَـٰدِ"},{"n":6002,"key":"89:9","text":"وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ"},{"n":6003,"key":"89:10","text":"وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ"},{"n":6004,"key":"89:11","text":"ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَـٰدِ"},{"n":6005,"key":"89:12","text":"فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ"},{"n":6006,"key":"89:13","text":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ"},{"n":6007,"key":"89:14","text":"إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ"},{"n":6008,"key":"89:15","text":"فَأَمَّا ٱلْإِنسَـٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ"},{"n":6009,"key":"89:16","text":"وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَـٰنَنِ"},{"n":6010,"key":"89:17","text":"كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ"},{"n":6011,"key":"89:18","text":"وَلَا تَحَـٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"},{"n":6012,"key":"89:19","text":"وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا"},{"n":6013,"key":"89:20","text":"وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا"},{"n":6014,"key":"89:21","text":"كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا"},{"n":6015,"key":"89:22","text":"وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا"},{"n":6016,"key":"89:23","text":"وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَـٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ"},{"n":6017,"key":"89:24","text":"يَقُولُ يَـٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى"},{"n":6018,"key":"89:25","text":"فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ"},{"n":6019,"key":"89:26","text":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ"},{"n":6020,"key":"89:27","text":"يَـٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ"},{"n":6021,"key":"89:28","text":"ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً"},{"n":6022,"key":"89:29","text":"فَٱدْخُلِى فِى عِبَـٰدِى"},{"n":6023,"key":"89:30","text":"وَٱدْخُلِى جَنَّتِى"}],"90":[{"n":6024,"key":"90:1","text":" لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ"},{"n":6025,"key":"90:2","text":"وَأَنتَ حِلٌّۢ بِهَـٰذَا ٱلْبَلَدِ"},{"n":6026,"key":"90:3","text":"وَوَالِدٍ وَمَا وَلَدَ"},{"n":6027,"key":"90:4","text":"لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِى كَبَدٍ"},{"n":6028,"key":"90:5","text":"أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ"},{"n":6029,"key":"90:6","text":"يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا"},{"n":6030,"key":"90:7","text":"أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ"},{"n":6031,"key":"90:8","text":"أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ"},{"n":6032,"key":"90:9","text":"وَلِسَانًا وَشَفَتَيْنِ"},{"n":6033,"key":"90:10","text":"وَهَدَيْنَـٰهُ ٱلنَّجْدَيْنِ"},{"n":6034,"key":"90:11","text":"فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ"},{"n":6035,"key":"90:12","text":"وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ"},{"n":6036,"key":"90:13","text":"فَكُّ رَقَبَةٍ"},{"n":6037,"key":"90:14","text":"أَوْ إِطْعَـٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ"},{"n":6038,"key":"90:15","text":"يَتِيمًا ذَا مَقْرَبَةٍ"},{"n":6039,"key":"90:16","text":"أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ"},{"n":6040,"key":"90:17","text":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ"},{"n":6041,"key":"90:18","text":"أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْمَيْمَنَةِ"},{"n":6042,"key":"90:19","text":"وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِنَا هُمْ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ"},{"n":6043,"key":"90:20","text":"عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌۢ"}]}