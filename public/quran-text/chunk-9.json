{"91":[{"n":6044,"key":"91:1","text":" وَٱلشَّمْسِ وَضُحَىٰهَا"},{"n":6045,"key":"91:2","text":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا"},{"n":6046,"key":"91:3","text":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا"},{"n":6047,"key":"91:4","text":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا"},{"n":6048,"key":"91:5","text":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا"},{"n":6049,"key":"91:6","text":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا"},{"n":6050,"key":"91:7","text":"وَنَفْسٍ وَمَا سَوَّىٰهَا"},{"n":6051,"key":"91:8","text":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا"},{"n":6052,"key":"91:9","text":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا"},{"n":6053,"key":"91:10","text":"وَقَدْ خَابَ مَن دَسَّىٰهَا"},{"n":6054,"key":"91:11","text":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ"},{"n":6055,"key":"91:12","text":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا"},{"n":6056,"key":"91:13","text":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا"},{"n":6057,"key":"91:14","text":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا"},{"n":6058,"key":"91:15","text":"وَلَا يَخَافُ عُقْبَـٰهَا"}],"92":[{"n":6059,"key":"92:1","text":" وَٱلَّيْلِ إِذَا يَغْشَىٰ"},{"n":6060,"key":"92:2","text":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ"},{"n":6061,"key":"92:3","text":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ"},{"n":6062,"key":"92:4","text":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ"},{"n":6063,"key":"92:5","text":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ"},{"n":6064,"key":"92:6","text":"وَصَدَّقَ بِٱلْحُسْنَىٰ"},{"n":6065,"key":"92:7","text":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ"},{"n":6066,"key":"92:8","text":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ"},{"n":6067,"key":"92:9","text":"وَكَذَّبَ بِٱلْحُسْنَىٰ"},{"n":6068,"key":"92:10","text":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ"},{"n":6069,"key":"92:11","text":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ"},{"n":6070,"key":"92:12","text":"إِنَّ عَلَيْنَا لَلْهُدَىٰ"},{"n":6071,"key":"92:13","text":"وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ"},{"n":6072,"key":"92:14","text":"فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ"},{"n":6073,"key":"92:15","text":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى"},{"n":6074,"key":"92:16","text":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ"},{"n":6075,"key":"92:17","text":"وَسَيُجَنَّبُهَا ٱلْأَتْقَى"},{"n":6076,"key":"92:18","text":"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ"},{"n":6077,"key":"92:19","text":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ"},{"n":6078,"key":"92:20","text":"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ"},{"n":6079,"key":"92:21","text":"وَلَسَوْفَ يَرْضَىٰ"}],"93":[{"n":6080,"key":"93:1","text":" وَٱلضُّحَىٰ"},{"n":6081,"key":"93:2","text":"وَٱلَّيْلِ إِذَا سَجَىٰ"},{"n":6082,"key":"93:3","text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ"},{"n":6083,"key":"93:4","text":"وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ"},{"n":6084,"key":"93:5","text":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ"},{"n":6085,"key":"93:6","text":"أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ"},{"n":6086,"key":"93:7","text":"وَوَجَدَكَ ضَآلًّا فَهَدَىٰ"},{"n":6087,"key":"93:8","text":"وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ"},{"n":6088,"key":"93:9","text":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ"},{"n":6089,"key":"93:10","text":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ"},{"n":6090,"key":"93:11","text":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ"}],"94":[{"n":6091,"key":"94:1","text":" أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ"},{"n":6092,"key":"94:2","text":"وَوَضَعْنَا عَنكَ وِزْرَكَ"},{"n":6093,"key":"94:3","text":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ"},{"n":6094,"key":"94:4","text":"وَرَفَعْنَا لَكَ ذِكْرَكَ"},{"n":6095,"key":"94:5","text":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا"},{"n":6096,"key":"94:6","text":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا"},{"n":6097,"key":"94:7","text":"فَإِذَا فَرَغْتَ فَٱنصَبْ"},{"n":6098,"key":"94:8","text":"وَإِلَىٰ رَبِّكَ فَٱرْغَب"}],"95":[{"n":6099,"key":"95:1","text":"وَٱلتِّينِ وَٱلزَّيْتُونِ"},{"n":6100,"key":"95:2","text":"وَطُورِ سِينِينَ"},{"n":6101,"key":"95:3","text":"وَهَـٰذَا ٱلْبَلَدِ ٱلْأَمِينِ"},{"n":6102,"key":"95:4","text":"لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍ"},{"n":6103,"key":"95:5","text":"ثُمَّ رَدَدْنَـٰهُ أَسْفَلَ سَـٰفِلِينَ"},{"n":6104,"key":"95:6","text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ"},{"n":6105,"key":"95:7","text":"فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ"},{"n":6106,"key":"95:8","text":"أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ"}],"96":[{"n":6107,"key":"96:1","text":" ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ"},{"n":6108,"key":"96:2","text":"خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ"},{"n":6109,"key":"96:3","text":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ"},{"n":6110,"key":"96:4","text":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ"},{"n":6111,"key":"96:5","text":"عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ"},{"n":6112,"key":"96:6","text":"كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ"},{"n":6113,"key":"96:7","text":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ"},{"n":6114,"key":"96:8","text":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ"},{"n":6115,"key":"96:9","text":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ"},{"n":6116,"key":"96:10","text":"عَبْدًا إِذَا صَلَّىٰٓ"},{"n":6117,"key":"96:11","text":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ"},{"n":6118,"key":"96:12","text":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ"},{"n":6119,"key":"96:13","text":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ"},{"n":6120,"key":"96:14","text":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ"},{"n":6121,"key":"96:15","text":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ"},{"n":6122,"key":"96:16","text":"نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ"},{"n":6123,"key":"96:17","text":"فَلْيَدْعُ نَادِيَهُۥ"},{"n":6124,"key":"96:18","text":"سَنَدْعُ ٱلزَّبَانِيَةَ"},{"n":6125,"key":"96:19","text":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩"}],"97":[{"n":6126,"key":"97:1","text":"إِنَّآ أَنزَلْنَـٰهُ فِى لَيْلَةِ ٱلْقَدْرِ"},{"n":6127,"key":"97:2","text":"وَمَآ أَدْرَىٰكَ مَا لَيْلَةُ ٱلْقَدْرِ"},{"n":6128,"key":"97:3","text":"لَيْلَةُ ٱلْقَدْرِ خَيْرٌ مِّنْ أَلْفِ شَهْرٍ"},{"n":6129,"key":"97:4","text":"تَنَزَّلُ ٱلْمَلَـٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍ"},{"n":6130,"key":"97:5","text":"سَلَـٰمٌ هِىَ حَتَّىٰ مَطْلَعِ ٱلْفَجْرِ"}],"98":[{"n":6131,"key":"98:1","text":" لَمْ يَكُنِ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَـٰبِ وَٱلْمُشْرِكِينَ مُنفَكِّينَ حَتَّىٰ تَأْتِيَهُمُ ٱلْبَيِّنَةُ"},{"n":6132,"key":"98:2","text":"رَسُولٌ مِّنَ ٱللَّهِ يَتْلُوا۟ صُحُفًا مُّطَهَّرَةً"},{"n":6133,"key":"98:3","text":"فِيهَا كُتُبٌ قَيِّمَةٌ"},{"n":6134,"key":"98:4","text":"وَمَا تَفَرَّقَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ إِلَّا مِنۢ بَعْدِ مَا جَآءَتْهُمُ ٱلْبَيِّنَةُ"},{"n":6135,"key":"98:5","text":"وَمَآ أُمِرُوٓا۟ إِلَّا لِيَعْبُدُوا۟ ٱللَّهَ مُخْلِصِينَ لَهُ ٱلدِّينَ حُنَفَآءَ وَيُقِيمُوا۟ ٱلصَّلَوٰةَ وَيُؤْتُوا۟ ٱلزَّكَوٰةَ ۚ وَذَٰلِكَ دِينُ ٱلْقَيِّمَةِ"},{"n":6136,"key":"98:6","text":"إِنَّ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَـٰبِ وَٱلْمُشْرِكِينَ فِى نَارِ جَهَنَّمَ خَـٰلِدِينَ فِيهَآ ۚ أُو۟لَـٰٓئِكَ هُمْ شَرُّ ٱلْبَرِيَّةِ"},{"n":6137,"key":"98:7","text":"إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ أُو۟لَـٰٓئِكَ هُمْ خَيْرُ ٱلْبَرِيَّةِ"},{"n":6138,"key":"98:8","text":"جَزَآؤُهُمْ عِندَ رَبِّهِمْ جَنَّـٰتُ عَدْنٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَآ أَبَدًا ۖ رَّضِىَ ٱللَّهُ عَنْهُمْ وَرَضُوا۟ عَنْهُ ۚ ذَٰلِكَ لِمَنْ خَشِىَ رَبَّهُۥ"}],"99":[{"n":6139,"key":"99:1","text":" إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا"},{"n":6140,"key":"99:2","text":"وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا"},{"n":6141,"key":"99:3","text":"وَقَالَ ٱلْإِنسَـٰنُ مَا لَهَا"},{"n":6142,"key":"99:4","text":"يَوْمَئِذٍ تُحَدِّثُ أَخْبَارَهَا"},{"n":6143,"key":"99:5","text":"بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا"},{"n":6144,"key":"99:6","text":"يَوْمَئِذٍ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًا لِّيُرَوْا۟ أَعْمَـٰلَهُمْ"},{"n":6145,"key":"99:7","text":"فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُۥ"},{"n":6146,"key":"99:8","text":"وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُۥ"}],"100":[{"n":6147,"key":"100:1","text":" وَٱلْعَـٰدِيَـٰتِ ضَبْحًا"},{"n":6148,"key":"100:2","text":"فَٱلْمُورِيَـٰتِ قَدْحًا"},{"n":6149,"key":"100:3","text":"فَٱلْمُغِيرَٰتِ صُبْحًا"},{"n":6150,"key":"100:4","text":"فَأَثَرْنَ بِهِۦ نَقْعًا"},{"n":6151,"key":"100:5","text":"فَوَسَطْنَ بِهِۦ جَمْعًا"},{"n":6152,"key":"100:6","text":"إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ"},{"n":6153,"key":"100:7","text":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ"},{"n":6154,"key":"100:8","text":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ"},{"n":6155,"key":"100:9","text":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ"},{"n":6156,"key":"100:10","text":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ"},{"n":6157,"key":"100:11","text":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ"}]}