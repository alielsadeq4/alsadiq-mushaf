{"101":[{"n":6158,"key":"101:1","text":" ٱلْقَارِعَةُ"},{"n":6159,"key":"101:2","text":"مَا ٱلْقَارِعَةُ"},{"n":6160,"key":"101:3","text":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ"},{"n":6161,"key":"101:4","text":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ"},{"n":6162,"key":"101:5","text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ"},{"n":6163,"key":"101:6","text":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ"},{"n":6164,"key":"101:7","text":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ"},{"n":6165,"key":"101:8","text":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ"},{"n":6166,"key":"101:9","text":"فَأُمُّهُۥ هَاوِيَةٌ"},{"n":6167,"key":"101:10","text":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ"},{"n":6168,"key":"101:11","text":"نَارٌ حَامِيَةٌۢ"}],"102":[{"n":6169,"key":"102:1","text":" أَلْهَىٰكُمُ ٱلتَّكَاثُرُ"},{"n":6170,"key":"102:2","text":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ"},{"n":6171,"key":"102:3","text":"كَلَّا سَوْفَ تَعْلَمُونَ"},{"n":6172,"key":"102:4","text":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ"},{"n":6173,"key":"102:5","text":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ"},{"n":6174,"key":"102:6","text":"لَتَرَوُنَّ ٱلْجَحِيمَ"},{"n":6175,"key":"102:7","text":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ"},{"n":6176,"key":"102:8","text":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ"}],"103":[{"n":6177,"key":"103:1","text":" وَٱلْعَصْرِ"},{"n":6178,"key":"103:2","text":"إِنَّ ٱلْإِنسَـٰنَ لَفِى خُسْرٍ"},{"n":6179,"key":"103:3","text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ"}],"104":[{"n":6180,"key":"104:1","text":" وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ"},{"n":6181,"key":"104:2","text":"ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ"},{"n":6182,"key":"104:3","text":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ"},{"n":6183,"key":"104:4","text":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ"},{"n":6184,"key":"104:5","text":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ"},{"n":6185,"key":"104:6","text":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ"},{"n":6186,"key":"104:7","text":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ"},{"n":6187,"key":"104:8","text":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ"},{"n":6188,"key":"104:9","text":"فِى عَمَدٍ مُّمَدَّدَةٍۭ"}],"105":[{"n":6189,"key":"105:1","text":" أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَـٰبِ ٱلْفِيلِ"},{"n":6190,"key":"105:2","text":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍ"},{"n":6191,"key":"105:3","text":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ"},{"n":6192,"key":"105:4","text":"تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ"},{"n":6193,"key":"105:5","text":"فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍۭ"}],"106":[{"n":6194,"key":"106:1","text":" لِإِيلَـٰفِ قُرَيْشٍ"},{"n":6195,"key":"106:2","text":"إِۦلَـٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ"},{"n":6196,"key":"106:3","text":"فَلْيَعْبُدُوا۟ رَبَّ هَـٰذَا ٱلْبَيْتِ"},{"n":6197,"key":"106:4","text":"ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍ وَءَامَنَهُم مِّنْ خَوْفٍۭ"}],"107":[{"n":6198,"key":"107:1","text":" أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ"},{"n":6199,"key":"107:2","text":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ"},{"n":6200,"key":"107:3","text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"},{"n":6201,"key":"107:4","text":"فَوَيْلٌ لِّلْمُصَلِّينَ"},{"n":6202,"key":"107:5","text":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ"},{"n":6203,"key":"107:6","text":"ٱلَّذِينَ هُمْ يُرَآءُونَ"},{"n":6204,"key":"107:7","text":"وَيَمْنَعُونَ ٱلْمَاعُونَ"}],"108":[{"n":6205,"key":"108:1","text":" إِنَّآ أَعْطَيْنَـٰكَ ٱلْكَوْثَرَ"},{"n":6206,"key":"108:2","text":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ"},{"n":6207,"key":"108:3","text":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ"}],"109":[{"n":6208,"key":"109:1","text":" قُلْ يَـٰٓأَيُّهَا ٱلْكَـٰفِرُونَ"},{"n":6209,"key":"109:2","text":"لَآ أَعْبُدُ مَا تَعْبُدُونَ"},{"n":6210,"key":"109:3","text":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ"},{"n":6211,"key":"109:4","text":"وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ"},{"n":6212,"key":"109:5","text":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ"},{"n":6213,"key":"109:6","text":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ"}],"110":[{"n":6214,"key":"110:1","text":" إِذَا جَآءَ نَصْرُ ٱللَّهِ وَٱلْفَتْحُ"},{"n":6215,"key":"110:2","text":"وَرَأَيْتَ ٱلنَّاسَ يَدْخُلُونَ فِى دِينِ ٱللَّهِ أَفْوَاجًا"},{"n":6216,"key":"110:3","text":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَٱسْتَغْفِرْهُ ۚ إِنَّهُۥ كَانَ تَوَّابًۢا"}]}